# docusaurus-theme-openapi-docs depends on postman-code-generators, whose postinstall
# shells out to yarn. In CI that fails: setup-node writes an .npmrc holding a
# ${NODE_AUTH_TOKEN} placeholder, and yarn cannot expand it. Those packages only back
# the API explorer, which this site does not render, so nothing here needs them built.
#
# npm still runs scripts invoked explicitly, so `npm run build` and `npm run lint` are
# unaffected. The exception is `prepare`, which installs the Husky hooks: run
# `npm run prepare` once after cloning.
ignore-scripts=true
